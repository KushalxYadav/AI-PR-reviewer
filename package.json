{
  "name": "ai-pr-reviewer",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered GitHub Pull Request reviewer Action using Google Gemini (Gemini 4 Argon)",
  "type": "module",
  "scripts": {
    "build": "ncc build src/index.ts -o dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@eslint/js": "^10.0.1",
    "@google/genai": "^3.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/ncc": "^0.45.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "eslint": "^10.14.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "minimatch": "^11.0.8",
    "motion": "^12.23.24",
    "prettier": "^3.9.10",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "5.8.2"
  }
}
